# Formspree form ID (the part after https://formspree.io/f/). Emails you every lead.
NEXT_PUBLIC_FORMSPREE_ID=

# Optional: also POST every lead as JSON to a webhook — e.g. a Google Apps Script web app that
# appends a row to a Google Sheet, or a Zapier / Make / HubSpot webhook. Leave empty to skip.
NEXT_PUBLIC_LEAD_WEBHOOK_URL=

# Analytics — pick one and set `analytics` in content/site.ts to match.
# Plausible (cookie-free, no banner needed): your domain, e.g. arcwell.digital
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXX (shows a cookie consent banner)
NEXT_PUBLIC_GA_ID=
